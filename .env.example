# Creator Network — configuration for docker compose (copy to .env and edit).
# .env is never committed. It contains no application secrets except SMTP credentials:
# sessions use random tokens stored hashed in the database, so there is no signing key.

# ---------------------------------------------------------------- public address
# The domain people will open. Its DNS A/AAAA record must point at this server
# before the first start, so Caddy can obtain a Let's Encrypt certificate.
DOMAIN=community.example.com
# Must be https://<DOMAIN>. Used for CSRF/WebSocket origin checks and links in emails.
APP_ORIGIN=https://community.example.com
# Contact for Let's Encrypt (certificate expiry notices).
ACME_EMAIL=admin@example.com
# Shown in the browser tab and emails (admins can also rename it in the admin settings).
APP_NAME=Creator Network

# ---------------------------------------------------------------- email (optional)
# Without SMTP, email verification and password-recovery emails are unavailable;
# admins can still create one-time reset links (admin dashboard or deploy/reset-link.sh).
# MAIL_TRANSPORT=auto uses SMTP when SMTP_HOST is set, otherwise disables email.
MAIL_TRANSPORT=auto
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465); false uses STARTTLS when offered.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Creator Network <no-reply@community.example.com>"

# ---------------------------------------------------------------- backups
# Automatic backups (database + uploads) into ./backups. 0 disables the schedule.
BACKUP_INTERVAL_HOURS=24
# How many backup archives to keep.
BACKUP_RETENTION=14

# ---------------------------------------------------------------- limits & logging
# Hard ceiling for uploads (MB); the admin setting can only choose a lower value.
MAX_UPLOAD_MB_HARD_LIMIT=100
SESSION_TTL_DAYS=30
LOG_LEVEL=info

# ---------------------------------------------------------------- advanced
# Memory limit for the app container (idle ≈130 MB; raise for very large communities).
APP_MEMORY_LIMIT=1g
# Host ports for Caddy (change only if something else uses 80/443).
HTTP_PORT=80
HTTPS_PORT=443
# Image overrides (e.g. a registry mirror). Defaults are pinned versions.
# NODE_IMAGE=node:24.21.0-bookworm-slim
# CADDY_IMAGE=caddy:2.11.7-alpine
# Password hashing cost (Argon2id). Defaults follow OWASP guidance (19 MiB, 2 passes).
# ARGON2_MEMORY_KIB=19456
# ARGON2_ITERATIONS=2

# Set by docker-compose.yml — do not override here:
#   NODE_ENV=production HOST=0.0.0.0 PORT=3000 DATA_DIR=/app/data BACKUP_DIR=/app/backups
#   TRUST_PROXY=172.28.0.0/24
