{
  "name": "@creator-network/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify API + Socket.IO real-time server + SQLite persistence.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "node build.mjs",
    "start": "node dist/main.js",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@creator-network/shared": "0.1.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.1.2",
    "@fastify/multipart": "10.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.5",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "file-type": "22.1.1",
    "image-size": "2.0.4",
    "nodemailer": "10.0.16",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/nodemailer": "8.0.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15"
  }
}
